              <button onclick="checkSpecificEligibility('${s.id}')" class="flex-1 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-semibold text-white">Check Eligibility</button>
              <a href="${s.official_url}" target="_blank" class="p-2 rounded-xl bg-electric-blue/10 text-electric-blue"><i data-lucide="external-link" class="w-4 h-4"></i></a>
            </div>
          </div>
        `;
      });
      lucide.createIcons();
    }

    // Initialize on Page Load
    window.addEventListener("DOMContentLoaded", initPlatform);
  </script>

      <!-- Government Portal Gateway / Availability Advisor Modal -->
      <div id="portal-gateway-modal" class="fixed inset-0 z-[100] bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="glass-card w-full max-w-md bg-[#10131B] border border-white/10 rounded-2xl shadow-2xl p-6 space-y-4">
          <div class="flex items-center justify-between border-b border-white/5 pb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-electric-blue/20 flex items-center justify-center text-electric-blue">
                <i data-lucide="external-link" class="w-5 h-5"></i>
              </div>
              <div>
                <h4 class="text-sm font-bold text-white" id="gateway-portal-title">Official Government Portal</h4>
                <p class="text-[11px] text-muted-grey">External Government Network Gateway</p>
              </div>
            </div>
            <button onclick="closeGatewayModal()" class="p-1.5 rounded-lg text-muted-grey hover:text-white bg-white/5 hover:bg-white/10 transition">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>

          <div class="p-3 rounded-xl bg-white/5 border border-white/5 space-y-1.5 text-xs text-muted-grey">
            <div class="flex items-center gap-1.5 text-white font-medium">
              <i data-lucide="shield-check" class="w-4 h-4 text-success-green"></i>
              <span>Official Department Destination:</span>
            </div>
            <p class="font-mono text-electric-blue break-all text-[11px]" id="gateway-portal-url"></p>
          </div>

          <div id="gateway-warning-notice" class="p-3 rounded-xl bg-warning-amber/10 border border-warning-amber/20 text-xs text-warning-amber space-y-1">
            <div class="flex items-center gap-1.5 font-semibold">
              <i data-lucide="alert-triangle" class="w-4 h-4"></i>
              <span>Government Portal Availability Advisory:</span>
            </div>
            <p class="text-white/80 text-[11px] leading-relaxed" id="gateway-warning-text">
              The official government portal is currently not responding. Please try again later or visit the department homepage.
            </p>
          </div>

          <div class="pt-2 space-y-2">
            <a id="gateway-proceed-btn" href="#" target="_blank" rel="noopener noreferrer" onclick="closeGatewayModal()" class="w-full btn-gradient py-2.5 rounded-xl text-xs font-bold text-white flex items-center justify-center gap-2 shadow-lg">
              <span>Proceed to Official Government Portal</span>
              <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
            </a>
            <a id="gateway-fallback-btn" href="#" target="_blank" rel="noopener noreferrer" onclick="closeGatewayModal()" class="w-full py-2 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-medium text-muted-grey hover:text-white flex items-center justify-center gap-2 transition border border-white/5">
              <i data-lucide="home" class="w-3.5 h-3.5"></i>
              <span id="gateway-fallback-title">Visit Department Official Homepage</span>
            </a>
          </div>
        </div>
      </div>
  

    <script>
      // Safe Government Portal Gateway Handler
      const KNOWN_DEPARTMENT_HOMEPAGES = {
        'uidai.gov.in': { title: 'UIDAI Official Portal', homepage: 'https://uidai.gov.in/', notice: 'UIDAI services may have security firewalls or high traffic. If MyAadhaar download times out, use the UIDAI official homepage or visit an authorized Aadhaar Seva Kendra.' },
        'myaadhaar.uidai.gov.in': { title: 'MyAadhaar Portal', homepage: 'https://uidai.gov.in/', notice: 'The official government portal is currently not responding. Please try again later or visit the department homepage.' },
        'incometax.gov.in': { title: 'Income Tax Department (e-Filing)', homepage: 'https://www.incometax.gov.in/iec/foportal/', notice: 'Official Income Tax Department portal. Instant e-PAN is generated with Aadhaar OTP.' },
        'passportindia.gov.in': { title: 'Passport Seva (MEA)', homepage: 'https://www.passportindia.gov.in/psp', notice: 'Official Ministry of External Affairs Passport Seva Portal.' },
        'voters.eci.gov.in': { title: 'Election Commission of India', homepage: 'https://voters.eci.gov.in/', notice: 'National Voters Service Portal of India.' },
        'parivahan.gov.in': { title: 'Ministry of Road Transport & Highways', homepage: 'https://parivahan.gov.in/', notice: 'Official Parivahan Sarathi Citizen Portal.' },
        'meeseva.telangana.gov.in': { title: 'MeeSeva Telangana Portal', homepage: 'https://ts.meeseva.telangana.gov.in/meeseva/home.htm', notice: 'Official Government of Telangana MeeSeva Services.' },
        'telanganaepass.cgg.gov.in': { title: 'Telangana ePASS', homepage: 'https://telanganaepass.cgg.gov.in/', notice: 'Telangana State Electronic Payment & Application System of Scholarships.' }
      };

      function getDepartmentFallback(url) {
        for (const [domain, info] of Object.entries(KNOWN_DEPARTMENT_HOMEPAGES)) {
          if (url.includes(domain)) return info;
        }
        return {
          title: 'Official Department Homepage',
          homepage: url,
          notice: 'The official government portal is currently not responding. Please try again later or visit the department homepage.'
        };
      }

      function safeOpenPortal(targetUrl, portalName) {
        const info = getDepartmentFallback(targetUrl);
        const modal = document.getElementById('portal-gateway-modal');
        if (!modal) {
          window.open(targetUrl, '_blank', 'noopener,noreferrer');
          return;
        }

        document.getElementById('gateway-portal-title').innerText = portalName || info.title;
        document.getElementById('gateway-portal-url').innerText = targetUrl;
        document.getElementById('gateway-warning-text').innerText = info.notice;
        
        const proceedBtn = document.getElementById('gateway-proceed-btn');
        proceedBtn.href = targetUrl;

        const fallbackBtn = document.getElementById('gateway-fallback-btn');
        fallbackBtn.href = info.homepage;
        document.getElementById('gateway-fallback-title').innerText = 'Visit ' + info.title + ' Homepage';

        modal.classList.remove('hidden');
        lucide.createIcons();
      }

      function closeGatewayModal() {
        const modal = document.getElementById('portal-gateway-modal');
        if (modal) modal.classList.add('hidden');
      }
    </script>
  
