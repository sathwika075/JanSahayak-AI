    // Run Deterministic Eligibility
    async function runEligibilityEvaluation() {
      const schemeId = document.getElementById("checker-scheme-select").value;
      const targetScheme = allSchemes.find(s => s.id === schemeId);
      if (!targetScheme) return;

      const income = Number(document.getElementById("checker-income").value);
      const category = document.getElementById("checker-category").value;
      const marks = Number(document.getElementById("checker-marks").value);
      const state = document.getElementById("checker-state").value;

      document.getElementById("eval-scheme-title").innerText = targetScheme.name;
      document.getElementById("eval-official-link").href = targetScheme.official_url;

      const criteria = [];
      let isEligible = true;

      // Income
      if (targetScheme.income_limit) {
        if (income <= targetScheme.income_limit) {
          criteria.push({ title: "Income Limit Satisfied", desc: `Your income (₹${income.toLocaleString('en-IN')}) is below ₹${targetScheme.income_limit.toLocaleString('en-IN')}.`, pass: true });
        } else {
          criteria.push({ title: "Income Limit Exceeded", desc: `Income (₹${income.toLocaleString('en-IN')}) exceeds scheme limit (₹${targetScheme.income_limit.toLocaleString('en-IN')}).`, pass: false });
          isEligible = false;
        }
      }

      // State Domicile
      if (targetScheme.state !== "All India (Central)") {
        if (state === targetScheme.state) {
          criteria.push({ title: "State Domicile Matches", desc: `Permanent resident of ${state}.`, pass: true });
        } else {
          criteria.push({ title: "Domicile Ineligible", desc: `Requires domicile in ${targetScheme.state}.`, pass: false });
          isEligible = false;
        }
      } else {
        criteria.push({ title: "National Central Scheme", desc: "Open to eligible students across all Indian states.", pass: true });
      }

      // Category
      if (targetScheme.category_eligible && !targetScheme.category_eligible.includes("All")) {
        if (targetScheme.category_eligible.includes(category)) {
          criteria.push({ title: "Social Category Qualified", desc: `Category ${category} is approved for this scheme.`, pass: true });
        } else {
          criteria.push({ title: "Category Reservation", desc: `Scheme designated for [${targetScheme.category_eligible.join(', ')}].`, pass: false });
          isEligible = false;
        }
      }

      // Badge & Explanation
      const badge = document.getElementById("eval-badge");
      const explanation = document.getElementById("eval-explanation");
      if (isEligible) {
        badge.className = "px-3 py-1 rounded-full text-xs font-bold bg-success-green/20 text-success-green border border-success-green/30";
        badge.innerText = "Fully Eligible";
        explanation.innerText = "Congratulations! Based on official published criteria, your profile satisfies all statutory eligibility requirements.";
      } else {
        badge.className = "px-3 py-1 rounded-full text-xs font-bold bg-neon-rose/20 text-neon-rose border border-neon-rose/30";
        badge.innerText = "Not Eligible";
        explanation.innerText = "You do not meet one or more verified government conditions. Review the unmet criteria below.";
      }

      // Render criteria list
      const list = document.getElementById("eval-criteria-list");
      list.innerHTML = "";
      criteria.forEach(c => {
        list.innerHTML += `
          <div class="p-3 bg-[#10131B] rounded-xl border border-white/5 flex items-start gap-3 text-xs">
            <i data-lucide="${c.pass ? 'check-circle-2' : 'x-circle'}" class="w-4 h-4 mt-0.5 ${c.pass ? 'text-success-green' : 'text-neon-rose'} shrink-0"></i>
            <div>
              <strong class="${c.pass ? 'text-white' : 'text-neon-rose'}">${c.title}</strong>
              <p class="text-muted-grey mt-0.5">${c.desc}</p>
            </div>
          </div>
        `;
      });
      lucide.createIcons();
    }

    // AI Chat Handling
    async function handleChatSubmit(e) {
      e.preventDefault();
      const input = document.getElementById("chat-input");
      const query = input.value.trim();
      if (!query) return;

      appendChatMessage("user", query);
      input.value = "";

      // Assistant Thinking State
      const thinkingId = appendChatThinking();

      try {
        const res = await fetch(`${API_BASE}/ai/chat`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message: query, language: currentLanguage })
        });

        document.getElementById(thinkingId)?.remove();

        if (res.ok) {
          const data = await res.json();
          appendChatMessage("assistant", data.answer, data.citations);
        } else {
          appendFallbackAnswer(query);
        }
      } catch (err) {
        document.getElementById(thinkingId)?.remove();
        appendFallbackAnswer(query);
      }
    }

