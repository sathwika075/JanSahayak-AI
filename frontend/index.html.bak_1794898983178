<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JanSahayak AI – Autonomous Government Services & Student Assistance Platform</title>
  <!-- Tailwind CSS & Lucide Icons via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            'jet-black': '#08090D',
            'secondary-dark': '#10131B',
            'dark-card': '#151B27',
            'cerulean': '#007BA7',
            'electric-blue': '#29B6F6',
            'neon-rose': '#FF2D87',
            'pink-highlight': '#FF4FA3',
            'muted-grey': '#9CA3AF',
            'success-green': '#22C55E',
            'warning-amber': '#F59E0B'
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #08090D;
      color: #F8FAFC;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .glass-card {
      background: rgba(21, 27, 39, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1rem;
    }
    /* ===== FIX: Ensure all hyperlinks in app are always clickable ===== */
    a[href] {
      pointer-events: auto !important;
      cursor: pointer !important;
      position: relative;
      z-index: 2;
    }
    a[href] svg,
    a[href] i[data-lucide] {
      pointer-events: none !important;
    }
    /* Modal and chat links take priority over any parent overflow/stacking */
    #modal-service-body a[href],
    #chat-messages-container a[href],
    .citizen-services-link {
      pointer-events: auto !important;
      cursor: pointer !important;
      z-index: 10;
    }
    .glass-card:hover {
      border-color: rgba(41, 182, 246, 0.3);
      box-shadow: 0 10px 25px -5px rgba(0, 123, 167, 0.15);
    }
    .gradient-text {
      background: linear-gradient(135deg, #29B6F6 0%, #FF2D87 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .badge-primary {
      background: linear-gradient(135deg, rgba(0, 123, 167, 0.2) 0%, rgba(41, 182, 246, 0.2) 100%);
      border: 1px solid rgba(41, 182, 246, 0.3);
      color: #29B6F6;
    }
    .btn-gradient {
      background: linear-gradient(135deg, #007BA7 0%, #29B6F6 50%, #FF2D87 100%);
      transition: all 0.3s ease;
    }
    .btn-gradient:hover {
      opacity: 0.95;
      box-shadow: 0 0 20px rgba(41, 182, 246, 0.4);
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #08090D;
    }
    ::-webkit-scrollbar-thumb {
      background: #1F2937;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #29B6F6;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col md:flex-row bg-[#08090D]">

  <!-- SIDEBAR NAVIGATION -->
  <aside class="w-full md:w-64 bg-[#10131B] border-r border-white/5 flex flex-col justify-between shrink-0">
    <div>
      <!-- Brand Logo -->
      <div class="p-6 border-b border-white/5 flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#007BA7] via-[#29B6F6] to-[#FF2D87] flex items-center justify-center shadow-lg shadow-cerulean/20">
          <i data-lucide="shield-check" class="w-6 h-6 text-white"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg leading-tight tracking-wider gradient-text">JANSAHAYAK</h1>
          <span class="text-xs text-[#9CA3AF] tracking-widest font-mono">GOVT AI PLATFORM</span>
        </div>
      </div>

      <!-- Navigation Links (All 9 Core Pages) -->
      <nav class="p-4 space-y-1" id="nav-menu">
        <button onclick="switchTab('dashboard')" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-white bg-white/5 border border-white/10" data-page="dashboard">
          <i data-lucide="layout-dashboard" class="w-5 h-5 text-[#29B6F6]"></i>
          <span>Home Dashboard</span>
        </button>

        <button onclick="switchTab('assistant')" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-[#9CA3AF] hover:text-white hover:bg-white/5" data-page="assistant">
          <i data-lucide="bot" class="w-5 h-5 text-[#FF2D87]"></i>
          <span>AI Govt Assistant</span>
        </button>

        <button onclick="switchTab('services')" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-[#9CA3AF] hover:text-white hover:bg-white/5" data-page="services">
          <i data-lucide="landmark" class="w-5 h-5 text-[#29B6F6]"></i>
          <span>Citizen Services</span>
        </button>

        <button onclick="switchTab('finder')" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-[#9CA3AF] hover:text-white hover:bg-white/5" data-page="finder">
          <i data-lucide="search" class="w-5 h-5 text-[#29B6F6]"></i>
          <span>Scholarship Finder</span>
        </button>

        <button onclick="switchTab('checker')" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-[#9CA3AF] hover:text-white hover:bg-white/5" data-page="checker">
          <i data-lucide="check-circle-2" class="w-5 h-5 text-[#22C55E]"></i>
          <span>Eligibility Checker</span>
        </button>

        <button onclick="switchTab('docs')" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-[#9CA3AF] hover:text-white hover:bg-white/5" data-page="docs">
          <i data-lucide="file-text" class="w-5 h-5 text-[#F59E0B]"></i>
          <span>Document OCR</span>
        </button>

        <button onclick="switchTab('guidance')" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-[#9CA3AF] hover:text-white hover:bg-white/5" data-page="guidance">
          <i data-lucide="compass" class="w-5 h-5 text-[#29B6F6]"></i>
          <span>Application Guidance</span>
        </button>

        <button onclick="switchTab('saved')" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-[#9CA3AF] hover:text-white hover:bg-white/5" data-page="saved">
          <i data-lucide="bookmark" class="w-5 h-5 text-[#FF4FA3]"></i>
          <span>Saved Schemes</span>
        </button>

        <button onclick="switchTab('profile')" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-[#9CA3AF] hover:text-white hover:bg-white/5" data-page="profile">
          <i data-lucide="user" class="w-5 h-5 text-white"></i>
          <span>Student Profile</span>
        </button>

        <div class="pt-4 border-t border-white/5 mt-4">
          <span class="px-4 text-xs font-semibold text-[#9CA3AF] uppercase tracking-wider">Administration</span>
          <button onclick="switchTab('knowledge')" class="nav-item mt-2 w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-[#9CA3AF] hover:text-white hover:bg-white/5" data-page="knowledge">
            <i data-lucide="database" class="w-5 h-5 text-[#29B6F6]"></i>
            <span>Knowledge Hub</span>
          </button>
          <button onclick="switchTab('admin')" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition text-[#9CA3AF] hover:text-white hover:bg-white/5" data-page="admin">
            <i data-lucide="bar-chart-3" class="w-5 h-5 text-[#FF2D87]"></i>
            <span>Admin Analytics</span>
          </button>
        </div>
      </nav>
    </div>

    <!-- Active User & Role Pill -->
    <div class="p-4 border-t border-white/5 bg-[#08090D]/50 m-4 rounded-xl">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-full bg-gradient-to-r from-cerulean to-neon-rose flex items-center justify-center font-bold text-sm">
          SR
        </div>
        <div class="overflow-hidden">
          <p class="text-sm font-semibold truncate text-white" id="user-display-name">Sathwika Reddy</p>
          <p class="text-xs text-muted-grey truncate">Telangana Student</p>
        </div>
      </div>
      <div class="mt-3 flex items-center justify-between text-xs text-muted-grey">
        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-success-green animate-pulse"></span> Verified DBT</span>
        <button onclick="toggleAuthModal()" class="text-electric-blue hover:underline">Switch User</button>
      </div>
    </div>
  </aside>

  <!-- MAIN VIEWPORT -->
  <main class="flex-1 overflow-y-auto p-4 md:p-8 space-y-8 max-w-7xl mx-auto w-full">

    <!-- TOP GLOBAL BAR -->
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/5">
      <div>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 text-xs font-semibold rounded-full badge-primary">Track 01: Civic Pulse & Digital Governance</span>
          <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-success-green/10 text-success-green border border-success-green/20">Telangana & Central Portal Verified</span>
        </div>
        <h2 id="page-header-title" class="text-2xl md:text-3xl font-extrabold text-white mt-2">Student Dashboard</h2>
      </div>

      <div class="flex items-center gap-3">
        <!-- Language Selector -->
        <div class="flex items-center bg-[#151B27] border border-white/10 rounded-xl p-1 text-xs">
          <button onclick="setLanguage('English')" id="lang-en" class="px-3 py-1.5 rounded-lg bg-electric-blue text-black font-semibold transition">English</button>
          <button onclick="setLanguage('Telugu')" id="lang-te" class="px-3 py-1.5 rounded-lg text-muted-grey hover:text-white transition">తెలుగు</button>
          <button onclick="setLanguage('Hindi')" id="lang-hi" class="px-3 py-1.5 rounded-lg text-muted-grey hover:text-white transition">हिन्दी</button>
        </div>

        <button onclick="switchTab('assistant')" class="btn-gradient px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 text-white shadow-lg">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
          <span>Ask JanSahayak AI</span>
        </button>
      </div>
    </header>

    <!-- NOTIFICATION TOAST CONTAINER -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 space-y-2 pointer-events-none"></div>

    <!-- ======================================================== -->
    <!-- PAGE 1: HOME DASHBOARD -->
    <!-- ======================================================== -->
    <section id="page-dashboard" class="space-y-8">
      <!-- Profile Completion & Greeting Banner -->
      <div class="glass-card p-6 md:p-8 bg-gradient-to-r from-[#151B27] via-[#10131B] to-[#151B27] relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-cerulean/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
          <div class="space-y-2">
            <span class="text-sm font-mono text-electric-blue">Namaste, Sathwika! Welcome to JanSahayak.</span>
            <h3 class="text-2xl font-bold text-white">Your Profile is <span class="text-success-green">95% Complete</span></h3>
            <p class="text-sm text-muted-grey max-w-xl">
              We have matched your profile with <strong class="text-white">4 verified government scholarship schemes</strong> with up to <strong class="text-neon-rose">₹100% tuition reimbursement</strong> and monthly maintenance allowances.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row items-center gap-3">
            <button onclick="switchTab('checker')" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition flex items-center justify-center gap-2 border border-white/10">
              <i data-lucide="check-check" class="w-4 h-4 text-success-green"></i> Run Full Check
            </button>
            <button onclick="switchTab('finder')" class="w-full sm:w-auto btn-gradient px-5 py-2.5 rounded-xl text-white font-semibold text-sm transition flex items-center justify-center gap-2">
              <i data-lucide="compass" class="w-4 h-4"></i> Explore All Schemes
            </button>
          </div>
        </div>

        <!-- Progress Bar -->
        <div class="mt-6 w-full bg-white/5 rounded-full h-2 overflow-hidden">
          <div class="bg-gradient-to-r from-cerulean via-electric-blue to-neon-rose h-2 rounded-full w-[95%]"></div>
        </div>
      </div>

      <!-- Quick Stats Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="glass-card p-5">
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-grey uppercase font-mono">Available Schemes</span>
            <div class="p-2 rounded-lg bg-cerulean/20 text-electric-blue"><i data-lucide="layers" class="w-4 h-4"></i></div>
          </div>
          <p class="text-2xl font-bold text-white mt-2" id="stat-total-schemes">8 Verified</p>
          <span class="text-xs text-success-green flex items-center gap-1 mt-1"><i data-lucide="shield-check" class="w-3 h-3"></i> 100% Official Gazette</span>
        </div>

        <div class="glass-card p-5">
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-grey uppercase font-mono">Matched Eligible</span>
            <div class="p-2 rounded-lg bg-success-green/20 text-success-green"><i data-lucide="sparkles" class="w-4 h-4"></i></div>
          </div>
          <p class="text-2xl font-bold text-white mt-2">3 Schemes</p>
          <span class="text-xs text-muted-grey mt-1">Based on income & category</span>
        </div>

        <div class="glass-card p-5">
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-grey uppercase font-mono">Next Deadline</span>
            <div class="p-2 rounded-lg bg-warning-amber/20 text-warning-amber"><i data-lucide="clock" class="w-4 h-4"></i></div>
          </div>
          <p class="text-2xl font-bold text-white mt-2">Nov 30, 2026</p>
          <span class="text-xs text-warning-amber mt-1">NSP CSSS closes soon</span>
        </div>

        <div class="glass-card p-5">
          <div class="flex items-center justify-between">
            <span class="text-xs text-muted-grey uppercase font-mono">Active Tracker</span>
            <div class="p-2 rounded-lg bg-neon-rose/20 text-neon-rose"><i data-lucide="navigation" class="w-4 h-4"></i></div>
          </div>
          <p class="text-2xl font-bold text-white mt-2">Step 3 of 5</p>
          <span class="text-xs text-electric-blue mt-1">ePASS Biometric Pending</span>
        </div>
      </div>

      <!-- Recommended Schemes Section -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <i data-lucide="award" class="w-5 h-5 text-electric-blue"></i>
            Recommended For Your Profile
          </h3>
          <button onclick="switchTab('finder')" class="text-xs text-electric-blue hover:underline">View All &rarr;</button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="dashboard-recommended-grid">
          <!-- Populated dynamically via JS -->
        </div>
      </div>
    </section>

    <!-- ======================================================== -->
    <!-- PAGE 2: AI GOVERNMENT ASSISTANT -->
    <!-- ======================================================== -->
    <section id="page-assistant" class="hidden space-y-6">
      <div class="glass-card p-6 flex flex-col h-[700px]">
        <!-- Chat Header -->
        <div class="flex items-center justify-between pb-4 border-b border-white/5">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cerulean via-electric-blue to-neon-rose flex items-center justify-center">
              <i data-lucide="bot" class="w-5 h-5 text-white"></i>
            </div>
            <div>
              <h3 class="font-bold text-white flex items-center gap-2">
                JanSahayak Grounded Assistant
                <span class="px-2 py-0.5 text-[10px] bg-success-green/20 text-success-green rounded-full font-mono">RAG Active</span>
              </h3>
              <p class="text-xs text-muted-grey">Answers sourced strictly from official government documents</p>
            </div>
          </div>
          <button onclick="clearChat()" class="text-xs text-muted-grey hover:text-white px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 flex items-center gap-1.5 transition">
            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Clear Chat
          </button>
        </div>

        <!-- Chat Conversation Area -->
        <div class="flex-1 overflow-y-auto py-4 space-y-4 pr-2" id="chat-messages-container">
          <!-- Initial Assistant Message -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-cerulean/30 flex items-center justify-center shrink-0">
              <i data-lucide="bot" class="w-4 h-4 text-electric-blue"></i>
            </div>
            <div class="glass-card p-4 max-w-2xl text-sm space-y-3">
              <p class="text-white">
                Namaste! Welcome to <strong>JanSahayak AI</strong> — your verified Citizen Services and Student Assistance Assistant.
              </p>
              <p class="text-white/80 text-xs leading-relaxed">
                I can help you with <strong>Government Scholarships</strong> (ePASS, NSP), <strong>Identity Documents</strong> (PAN, Aadhaar, Voter ID), <strong>Travel Services</strong> (Passport, Driving Licence), <strong>Banking Guidance</strong> (Passbook, ATM cards, zero-balance accounts), and <strong>State Certificates</strong> (Income, Caste, Domicile via MeeSeva).
              </p>
              <!-- Service Shortcuts -->
              <div class="pt-2 flex flex-wrap gap-1.5 text-xs">
                <button onclick="sendQuickPrompt('Which scholarships can I apply for?')" class="px-2.5 py-1 rounded-lg bg-electric-blue/10 hover:bg-electric-blue/20 text-electric-blue border border-electric-blue/20 flex items-center gap-1 transition">🎓 Scholarships</button>
                <button onclick="sendQuickPrompt('How do I apply for a PAN card?')" class="px-2.5 py-1 rounded-lg bg-cerulean/20 hover:bg-cerulean/30 text-white border border-white/10 flex items-center gap-1 transition">💳 PAN Card</button>
                <button onclick="sendQuickPrompt('How do I download Aadhaar?')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-white border border-white/10 flex items-center gap-1 transition">🆔 Aadhaar</button>
                <button onclick="sendQuickPrompt('How do I apply for a passport?')" class="px-2.5 py-1 rounded-lg bg-neon-rose/10 hover:bg-neon-rose/20 text-[#FF4FA3] border border-neon-rose/20 flex items-center gap-1 transition">✈️ Passport</button>
                <button onclick="sendQuickPrompt('How do I request an ATM card?')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-white border border-white/10 flex items-center gap-1 transition">🏦 Banking</button>
                <button onclick="sendQuickPrompt('How do I apply for an income certificate?')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-white border border-white/10 flex items-center gap-1 transition">📜 Certificates</button>
              </div>
              <div class="pt-2 text-[11px] text-muted-grey flex items-center gap-1 border-t border-white/5">
                <i data-lucide="shield-check" class="w-3.5 h-3.5 text-success-green"></i> Grounded strictly on official government gazettes, RBI directions, and verified portals.
              </div>
            </div>
          </div>
        </div>

        <!-- Dynamic Suggested Prompt Chips -->
        <div class="py-2 flex items-center gap-2 overflow-x-auto text-xs text-muted-grey" id="chat-suggested-chips-container">
          <span class="shrink-0 font-semibold text-white/70">Suggested:</span>
          <button onclick="sendQuickPrompt('Which government scholarships can I apply for?')" class="shrink-0 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-electric-blue transition border border-white/5">Which scholarships can I apply for?</button>
          <button onclick="sendQuickPrompt('How do I apply for a PAN card?')" class="shrink-0 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-electric-blue transition border border-white/5">How to apply for PAN card?</button>
          <button onclick="sendQuickPrompt('How do I apply for a passport?')" class="shrink-0 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-electric-blue transition border border-white/5">Passport application steps?</button>
          <button onclick="sendQuickPrompt('How do I download Aadhaar?')" class="shrink-0 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-electric-blue transition border border-white/5">Download Aadhaar card?</button>
          <button onclick="sendQuickPrompt('How do I block my lost ATM card?')" class="shrink-0 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-electric-blue transition border border-white/5">Block lost ATM card?</button>
          <button onclick="sendQuickPrompt('How do I apply for an income certificate?')" class="shrink-0 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-electric-blue transition border border-white/5">MeeSeva Income Certificate?</button>
        </div>

        <!-- Chat Input Form -->
        <form onsubmit="handleChatSubmit(event)" class="pt-3 border-t border-white/5 flex items-center gap-2">
          <input type="text" id="chat-input" placeholder="Ask about scholarships, eligibility, income limits, or documents..." class="flex-1 bg-[#10131B] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-electric-blue transition placeholder:text-muted-grey/60" autocomplete="off">
          
          <button type="button" onclick="startVoiceRecognition()" id="mic-btn" title="Voice Input" class="p-3 rounded-xl bg-white/5 hover:bg-white/10 text-muted-grey hover:text-white transition">
            <i data-lucide="mic" class="w-5 h-5"></i>
          </button>

          <button type="submit" class="btn-gradient px-5 py-3 rounded-xl text-white font-semibold text-sm flex items-center gap-2 shadow-lg hover:shadow-cerulean/20 transition">
            <span>Send</span>
            <i data-lucide="send" class="w-4 h-4"></i>
          </button>
        </form>
      </div>
    </section>

    <!-- ======================================================== -->
    <!-- PAGE 2B: CITIZEN SERVICES HUB (IDENTITY, TRAVEL, BANKING, CERTIFICATES) -->
    <!-- ======================================================== -->
    <section id="page-services" class="hidden space-y-8">
      <!-- Banner & Introduction -->
      <div class="glass-card p-6 md:p-8 bg-gradient-to-r from-[#151B27] via-[#10131B] to-[#151B27] relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-electric-blue/10 rounded-full blur-3xl pointer-events-none"></div>
