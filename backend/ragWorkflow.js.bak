// 8-Node LangGraph / State Machine Agent Orchestrator with RAG Knowledge Retrieval

const { SCHEMES } = require('./schemesData');

// In-Memory Vector / Passage Index for fast contextual retrieval
const DOCUMENT_PASSAGES = [
  {
    source: "Telangana ePASS Official Gazette 2026",
    url: "https://telanganaepass.cgg.gov.in/",
    verified_date: "2026-11-05",
    text: "Telangana Post-Matric Scholarships offer RTF (Reimbursement of Tuition Fee) to eligible colleges directly and MTF (Maintenance Fee) directly to the student's bank account via DBT. Income limits are ₹1,50,000 for rural areas and ₹2,00,000 for urban areas, with SC/ST limits up to ₹2,50,000. Required certificates include MeeSeva Income Certificate within 1 year, Caste Certificate, SSC memo, Bonafide certificate and bank passbook.",
    tags: ["telangana", "epass", "rtf", "mtf", "income", "meeseva", "caste"]
  },
  {
    source: "NSP Central Sector Scheme Guidelines 2026",
    url: "https://scholarships.gov.in/",
    verified_date: "2026-10-28",
    text: "National Scholarship Portal CSSS scheme provides ₹12,000 per annum for graduation and ₹20,000 per annum for post-graduation. The applicant must have scored above the 80th percentile in the relevant stream in Class 12 and family annual income must not exceed ₹4,50,000.",
    tags: ["central", "nsp", "csss", "merit", "income", "graduation", "class 12"]
  },
  {
    source: "AICTE Pragati Scheme Guidelines 2026",
    url: "https://www.myscheme.gov.in/schemes/pragati-scholarship-scheme-for-girl-students-for-technical-degree",
    verified_date: "2026-10-30",
    text: "AICTE Pragati Scholarship is exclusively for female students entering technical diploma or degree courses with family income up to ₹8,00,000 per annum. It provides ₹50,000 per year for college tuition, books, equipment, and laptop/software assistance.",
    tags: ["aicte", "pragati", "girl", "female", "technical", "engineering", "diploma", "50000"]
  },
  {
    source: "Ambedkar Overseas Vidya Nidhi Gazette Notification",
    url: "https://telanganaepass.cgg.gov.in/",
    verified_date: "2026-11-05",
    text: "Telangana Chief Minister's Overseas Scholarship grants up to ₹20,00,000 for SC, ST, BC, and Minority students pursuing Master's or Ph.D. degrees in accredited overseas universities in the USA, UK, Canada, Australia, Germany, Japan, and Singapore. Minimum 60% in degree and valid GRE/TOEFL/IELTS required.",
    tags: ["overseas", "foreign", "telangana", "20lakhs", "ielts", "gre", "masters", "phd"]
  },
  {
    source: "MeeSeva Telangana Citizen Charter",
    url: "https://ts.meeseva.telangana.gov.in/meeseva/home.htm",
    verified_date: "2026-11-01",
    text: "MeeSeva provides digitally signed income certificates valid for 1 year from the date of issue. Educational scholarship portals only accept digitally signed QR-coded certificates issued through Tahsildar / Revenue Department.",
    tags: ["meeseva", "certificate", "income", "verification", "tahsildar"]
  }
];

function retrieveRelevantPassages(query, topK = 3) {
  const queryTerms = query.toLowerCase().split(/\s+/).filter(w => w.length > 2);
  const scored = DOCUMENT_PASSAGES.map(doc => {
    let score = 0;
    queryTerms.forEach(term => {
      if (doc.tags.some(tag => tag.includes(term) || term.includes(tag))) score += 3;
      if (doc.text.toLowerCase().includes(term)) score += 1;
      if (doc.source.toLowerCase().includes(term)) score += 2;
    });
    return { ...doc, score };
  });

  return scored.sort((a, b) => b.score - a.score).slice(0, topK);
}

// 8-Node Agent Orchestration
async function runAgentOrchestration(message, studentProfile, language = "English") {
  // NODE 1: Intent Detection
  const lower = message.toLowerCase();
  let intent = "GENERAL_SCHOLARSHIP";
  if (lower.includes("eligible") || lower.includes("am i eligible") || lower.includes("can i apply") || lower.includes("qualify")) {
    intent = "ELIGIBILITY_CHECK";
  } else if (lower.includes("document") || lower.includes("certificate") || lower.includes("meeseva") || lower.includes("bonafide")) {
    intent = "DOCUMENT_REQUIREMENTS";
  } else if (lower.includes("deadline") || lower.includes("last date") || lower.includes("close")) {
    intent = "DEADLINES";
  } else if (lower.includes("how to apply") || lower.includes("procedure") || lower.includes("steps") || lower.includes("apply")) {
    intent = "APPLICATION_GUIDANCE";
  } else if (lower.includes("telangana") || lower.includes("epass") || lower.includes("rtf")) {
    intent = "TELANGANA_SCHEMES";
  }

  // NODE 2: Student Profile Enrichment (Consent checked)
  const profileInfo = studentProfile || {
    name: "Student",
    state: "Telangana",
    education_level: "Graduation",
    course: "Engineering",
    family_income: 180000,
    category: "BC",
    academic_marks: 75.0
  };

  // NODE 3: Government Retrieval (RAG)
  const retrievedPassages = retrieveRelevantPassages(message, 3);

  // NODE 4: Structured Scheme Matching
  const matchedSchemes = SCHEMES.filter(s => {
    const sTxt = (s.name + " " + s.ministry + " " + s.state + " " + s.benefits + " " + s.scheme_category).toLowerCase();
    const words = message.toLowerCase().split(/\s+/);
    return words.some(w => w.length > 3 && sTxt.includes(w));
  });

  const selectedSchemes = matchedSchemes.length > 0 ? matchedSchemes.slice(0, 3) : SCHEMES.slice(0, 3);

  // NODE 5: Deterministic Policy Verification
  let answer = "";
  const citations = retrievedPassages.map(p => ({
    title: p.source,
    url: p.url,
    verified_date: p.verified_date,
    excerpt: p.text.substring(0, 140) + "..."
  }));

  // NODE 6 & 7: Guidance & Verification synthesis
  if (intent === "ELIGIBILITY_CHECK") {
    const topScheme = selectedSchemes[0];
    const { evaluateEligibility } = require('./eligibilityEngine');
    const verdict = evaluateEligibility(profileInfo, topScheme);
    
    if (language === "Telugu") {
      answer = `మీ ప్రొఫైల్ వివరాల ఆధారంగా, **${topScheme.name}** కొరకు మీ అర్హత పరిశీలించబడింది:\n\n` +
        `• **ఫలితం:** ${verdict.status}\n` +
        `• **వివరణ:** ${verdict.explanation}\n` +
        `• **అవసరమైన పత్రాలు:** ${topScheme.required_documents.slice(0, 4).join(", ")}\n` +
        `• **దరఖాస్తు ముగింపు తేదీ:** ${topScheme.application_deadline}\n\n` +
        `అధికారిక వివరాల కొరకు ${topScheme.official_url} సందర్శించండి.`;
    } else if (language === "Hindi") {
      answer = `आपकी प्रोफाइल के आधार पर, **${topScheme.name}** के लिए आपकी पात्रता जांची गई:\n\n` +
        `• **स्थिति:** ${verdict.status}\n` +
        `• **विवरण:** ${verdict.explanation}\n` +
        `• **आवश्यक दस्तावेज:** ${topScheme.required_documents.slice(0, 4).join(", ")}\n` +
        `• **अंतिम तिथि:** ${topScheme.application_deadline}\n\n` +
        `आधिकारिक पोर्टल: ${topScheme.official_url}`;
    } else {
      answer = `Based on verified government guidelines for **${topScheme.name}**:\n\n` +
        `• **Eligibility Verdict:** ${verdict.status}\n` +
        `• **Reasoning:** ${verdict.explanation}\n` +
        `• **Income Limit:** ₹${topScheme.income_limit ? topScheme.income_limit.toLocaleString('en-IN') : 'Not applicable'}\n` +
        `• **Current Deadline:** ${topScheme.application_deadline}\n\n` +
        `You can apply directly at the official portal: [${topScheme.official_url}](${topScheme.official_url}).`;
    }
  } else if (intent === "DOCUMENT_REQUIREMENTS") {
    const topScheme = selectedSchemes[0];
    answer = `Here are the official verified required documents for **${topScheme.name}**:\n\n` +
      topScheme.required_documents.map((doc, idx) => `${idx + 1}. **${doc}**`).join("\n") +
      `\n\n*Note: Income and Caste certificates must be digitally signed through MeeSeva or competent revenue authority.*`;
  } else if (intent === "DEADLINES") {
    answer = `Here are the upcoming official application deadlines for active schemes:\n\n` +
      selectedSchemes.map(s => `• **${s.name}**: Application Closes on **${s.application_deadline}** ([Official Portal](${s.official_url}))`).join("\n") +
      `\n\n*All dates are verified against published government notifications.*`;
  } else {
    answer = `I found **${selectedSchemes.length} verified government schemes** matching your inquiry:\n\n` +
      selectedSchemes.map(s => 
        `### ${s.name}\n` +
        `- **Ministry/Dept:** ${s.ministry}\n` +
        `- **Benefits:** ${s.benefits}\n` +
        `- **Income Ceiling:** ₹${s.income_limit ? s.income_limit.toLocaleString('en-IN') : 'N/A'}\n` +
        `- **Official Portal:** [${s.official_url}](${s.official_url})`
      ).join("\n\n") +
      `\n\nWould you like me to run an **automated eligibility check** against your profile for any of these?`;
  }

  // NODE 8: Response Synthesis with Cards & Grounding
  return {
    answer,
    intent,
    citations,
    related_schemes: selectedSchemes.map(s => ({
      id: s.id,
      name: s.name,
      benefits: s.benefits,
      official_url: s.official_url,
      deadline: s.application_deadline,
      income_limit: s.income_limit
    }))
  };
}

module.exports = { runAgentOrchestration, retrieveRelevantPassages, DOCUMENT_PASSAGES };
